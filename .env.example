# EXAMPLE — copy to .env (gitignored) and fill in real values locally.
# The .env file is NEVER committed. Credentials only ever live here at runtime,
# never in code.

# Anthropic API key for bill extraction
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxx

# Utility provider logins (one block per provider you add locally)
PROVIDER1_URL=https://example-water-utility.com/login
PROVIDER1_USERNAME=your-username
PROVIDER1_PASSWORD=your-password
